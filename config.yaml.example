# Coinbase API Credentials
# IMPORTANT: Copy this file to config.yaml and add your real credentials
# DO NOT commit config.yaml to version control
api:
  # Your Coinbase API key name
  key_name: "your_key_name_here"
  # Your Coinbase API private key
  private_key: "your_private_key_here"

# Trading Configuration
trading:
  # Dry run mode - simulates trading without executing real orders
  # Set to true for testing, false for live trading
  dry_run: true
  # The trading pair to monitor (e.g., MON-USDC, BTC-USD)
  product_id: "MON-USDC"

  # How often to poll the price (in seconds)
  poll_interval: 5

  # Emergency stop-loss: if price drops below this, SELL IMMEDIATELY
  # This is your absolute floor - the bot will sell if price hits this
  emergency_stop_price: 0.50

  # Trailing stop-loss configuration
  trailing_stop:
    # Initial stop-loss price (where to start the trailing stop)
    initial_stop_price: 0.55

    # Percentage increase needed before moving the stop-loss up
    # Example: 5.0 means the price must go up 5% before adjusting the stop
    threshold_percentage: 5.0

    # How much below the current price should the trailing stop be
    # Example: 3.0 means keep the stop 3% below the current price
    trail_percentage: 3.0

# Logging
logging:
  # Enable verbose output
  verbose: true
