# Coinbase API Credentials
# IMPORTANT: Copy this file to config.yaml and add your real credentials
# DO NOT commit config.yaml to version control
api:
  # Your Coinbase API key name
  key_name: "your_key_name_here"
  # Your Coinbase API private key
  private_key: "your_private_key_here"

# Trading Configuration
trading:
  # Dry run mode - simulates trading without executing real orders
  # Set to true for testing, false for live trading
  dry_run: true
  # The trading pair to monitor (e.g., MON-USDC, BTC-USD)
  product_id: "MON-USDC"

  # How often to poll the price (in seconds)
  poll_interval: 5

  # Emergency stop-loss percentage below opening price
  # Example: 20.0 means emergency stop is 20% below opening price
  # If opens at $0.035, emergency stop will be $0.028 (20% below)
  emergency_stop_percentage: 20.0

  # Trailing stop-loss configuration
  trailing_stop:
    # Percentage increase needed before moving the stop-loss up
    # Example: 3.0 means the price must go up 3% before adjusting the stop
    threshold_percentage: 3.0

    # How much below the current price should the trailing stop be
    # Example: 10.0 means keep the stop 10% below the current price
    # The initial stop is auto-calculated as: opening_price * (1 - trail_percentage / 100)
    trail_percentage: 10.0

# Logging
logging:
  # Enable verbose output
  verbose: true
